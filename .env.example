# Copy to .env and fill in. Empty optional values switch the service off.

# Database: postgres://… or postgresql://… → Postgres; anything else → local SQLite file.
DATABASE_URI=file:./handeye.db
# Required with Postgres. Local SQLite works without it.
PAYLOAD_SECRET=
# REQUIRED in production (`next start`, SITE_ENV=production): the server refuses to start without it.
# Public URL of the site: canonical links, sitemap, redirects, admin links, Mux upload CORS.
# Local development default: http://localhost:3210
NEXT_PUBLIC_SERVER_URL=
# "production" only on the live domain; anything else = noindex + robots Disallow.
SITE_ENV=

# File storage: set to store uploads in Vercel Blob; empty = local media/ folder.
BLOB_READ_WRITE_TOKEN=

# Video hosting (Mux): both required to switch it on; empty = placeholder uploads.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=

# Email: set SMTP_HOST to send via SMTP; empty = emails are written to the server log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Local test admin user for scripts/checks (test values only, never real ones).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
