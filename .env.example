# Copy to .env and fill in. Empty optional values switch the service off.

# Database: postgres://… or postgresql://… → Postgres; anything else → local SQLite file.
DATABASE_URI=file:./handeye.db
# Required with Postgres. Local SQLite works without it.
PAYLOAD_SECRET=
# REQUIRED in production (`next start`, SITE_ENV=production): the server refuses to start without it.
# Public URL of the site: canonical links, sitemap, redirects, admin links, Mux upload CORS.
# Local development default: http://localhost:3210
NEXT_PUBLIC_SERVER_URL=
# "production" only on the live domain; anything else = noindex + robots Disallow.
SITE_ENV=

# File storage: set to store uploads in Vercel Blob; empty = local media/ folder.
BLOB_READ_WRITE_TOKEN=

# Video hosting (Mux): both required to switch it on; empty = placeholder uploads.
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
MUX_WEBHOOK_SIGNING_SECRET=

# Email: set SMTP_HOST to send via SMTP; empty = emails are written to the server log.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=
EMAIL_FROM_NAME=

# Payments (Stripe, hosted Checkout — no publishable key needed).
# Secret key of the account (sk_test_… locally and on staging, sk_live_… on the client's account).
STRIPE_SECRET_KEY=
# Signing secret of the webhook endpoint (whsec_…): from `stripe listen --print-secret` locally; in production from
# `npm run stripe:setup -- --webhook <url>` (written by --secret-file / --write-env) or the Dashboard endpoint.
STRIPE_WEBHOOK_SECRET=
# "stripe" (default when STRIPE_SECRET_KEY is set) or "fake": an in-process gateway for tests, no network.
PAYMENT_GATEWAY=
# Shared secret of GET /cron/daily (reminders and follow-up emails); the route answers 401 without it.
CRON_SECRET=

# Ad tracking: each id switches its tag on; leave empty on the test site so it does not feed the live pixel.
# Meta pixel id (digits). With META_CAPI_TOKEN (Events Manager → Settings → Conversions API → Generate access token)
# every paid order is also sent from the server, with the browser's event id, so Meta counts it once.
META_PIXEL_ID=
META_CAPI_TOKEN=
# Test events code from Events Manager → Test events: server events go to that tab instead of the live data.
META_TEST_EVENT_CODE=
# Google Ads tag id (AW-…). With a conversion label the thank-you page sends the purchase with the real total.
GOOGLE_ADS_ID=
GOOGLE_ADS_PURCHASE_LABEL=

# Mailing list (Mailchimp): both set → a buyer who ticks "email me new class dates" is added once paid,
# tagged with the city of the studio. API key from Profile → Extras → API keys (ends in -usNN); audience id
# from Audience → Settings → Audience name and defaults.
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=

# Local test admin user for scripts/checks (test values only, never real ones).
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
