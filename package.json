{
  "name": "handeye-redesign",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev -p 3210",
    "build": "cross-env NODE_OPTIONS=--no-deprecation next build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start -p 3210",
    "lint": "next lint",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation MUX_TOKEN_ID=importmap MUX_TOKEN_SECRET=importmap payload generate:importmap",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run scripts/seed/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@mux/mux-player-react": "^3.13.4",
    "@oversightstudio/mux-video": "^1.4.1",
    "@payloadcms/db-postgres": "~3.90.2",
    "@payloadcms/db-sqlite": "~3.90.2",
    "@payloadcms/email-nodemailer": "~3.90.2",
    "@payloadcms/next": "~3.90.2",
    "@payloadcms/plugin-redirects": "~3.90.2",
    "@payloadcms/richtext-lexical": "~3.90.2",
    "@payloadcms/storage-vercel-blob": "~3.90.2",
    "@payloadcms/ui": "~3.90.2",
    "cross-env": "^10.1.0",
    "framer-motion": "^12.43.0",
    "graphql": "^16.14.2",
    "next": "~16.3.8",
    "payload": "~3.90.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "cheerio": "^1.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.3",
    "vitest": "^3.2.7"
  },
  "type": "module"
}
