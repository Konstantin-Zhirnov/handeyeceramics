node_modules
.next
out
.env*

# TypeScript incremental build cache — regenerated on every build
*.tsbuildinfo

# Knowledge base: client correspondence and notes — never publish (public repo)
/raw/
/wiki/

# Autopilot run records: client requirements — never publish (public repo)
/.autopilot/

# Env templates are public; real .env files are not
!.env.example

# Local CMS data: SQLite database and uploaded files
*.db
*.db-journal
*.db-wal
*.db-shm
/media/

# Crawled images: re-downloadable with scripts/crawl/crawl.py; too heavy for git
/content/images/

# Handover material for the owner (screen recordings): not for the public repo
/handover/

# One-off backups taken by scripts/dedupe-media.mts before writing to a database
/backups/
